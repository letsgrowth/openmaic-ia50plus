# Non-secret deployment values only. Secrets live outside Git.
IA50_SECRETS_DIR=/opt/ia50-secrets
OPENMAIC_IA50_IMAGE_TAG=v0.3.1-ia50

# Editorial generation gates. Research uses the private IA50 SearXNG service.
# Media gates stay off until a server-owned provider and spend alert are set.
IA50_CONTENT_WEB_SEARCH=true
IA50_CONTENT_IMAGE_GENERATION=false
IA50_CONTENT_VIDEO_GENERATION=false
IA50_CONTENT_TTS=false
